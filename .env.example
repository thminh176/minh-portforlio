# ==============================================================================
# damthienminh.id.vn - Environment Configuration Template
# All production secrets are configured in Cloudflare Pages dashboard.
# Do NOT store real secrets or sensitive values in this file or any Git-tracked file.
# ==============================================================================

# Client Build Flags & Public Keys (Baked in at static export time)
# Contact sending is disabled by default unless explicitly enabled with a valid Turnstile site key.
NEXT_PUBLIC_CONTACT_ENABLED=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server Secrets (Configured as Environment Variables / Secrets in Cloudflare Pages Functions)
# Mandatory Server Bindings (All 6 are required for live email delivery):
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_EXPECTED_ACTION=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional Secondary Notification (Generic alert only, zero visitor PII):
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
