# Dependencies
node_modules/
.pnpm-store/

# Next.js build output and caches
.next/
out/
*.tsbuildinfo
.cache/
.turbo/
.wrangler/

# Environment and secrets (allow .env.example only)
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*

# Cryptographic and private keys (protect secrets without blocking public assets)
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# Logs and debug
debug.log
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local-only evidence reports (preserve durable milestone reports like m0a.md)
reports/*.local.*
reports/*.local
reports/local/
reports/tmp/

# OS / Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.sw?
