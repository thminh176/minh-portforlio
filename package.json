{
  "name": "damthienminh-portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/normalize-static-export.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:secrets": "node scripts/test-check-secrets.mjs",
    "test:contact": "node --experimental-strip-types scripts/test-contact-api.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm check:secrets && pnpm test:secrets && pnpm test:contact",
    "smoke:export": "node scripts/smoke-export.mjs",
    "pages:dev": "wrangler pages dev out --compatibility-date=2026-10-06",
    "test:pages": "node scripts/verify-wrangler-pages.mjs",
    "test:pages:failure-paths": "node scripts/verify-wrangler-pages.mjs --test-failure-paths",
    "test:contact:browser": "node scripts/test-enabled-contact-browser.mjs",
    "test:browser": "node scripts/verify-browser.mjs",
    "ci": "pnpm check && pnpm build && pnpm smoke:export",
    "test:lighthouse": "node scripts/verify-lighthouse.mjs",
    "test:content": "node --experimental-strip-types scripts/test-content-snapshot.mjs"
  },
  "dependencies": {
    "next": "^16.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "6.15.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.1",
    "lighthouse": "13.5.0",
    "playwright-core": "^1.64.0",
    "postcss": "^8.5.29",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "wrangler": "4.149.0"
  }
}
